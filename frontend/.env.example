
VITE_API_URL=http://localhost:5000
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Realtime for booking chat (OPTIONAL).
# Get both from your Supabase dashboard → Settings → API.
# The anon/public key is safe to expose in the browser. If you leave these
# blank, chat still works — it just auto-refreshes every few seconds instead
# of updating instantly.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
